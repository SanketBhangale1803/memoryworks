# Copy this file to .env.production on the VM. Never commit the populated file.
# A free hostname can be based on the public IP, for example:
# PUBLIC_DOMAIN=203-0-113-10.sslip.io
PUBLIC_DOMAIN=
TLS_EMAIL=

# Set only when the web app is hosted elsewhere and forwards /api/* and
# /.well-known/* to api.<PUBLIC_DOMAIN> (memoryworks.app on Vercel:
# PUBLIC_DOMAIN=memoryworks.app, SITE_URL=https://memoryworks.app). OAuth
# callbacks are then registered on SITE_URL, not api.<PUBLIC_DOMAIN>.
SITE_URL=

ARCADEDB_PASSWORD=
JWT_SECRET=
NEXTAUTH_SECRET=

# Create a GitHub OAuth app after PUBLIC_DOMAIN is known. Homepage URL:
# https://app.<PUBLIC_DOMAIN> (or SITE_URL)
# Callback URL: https://api.<PUBLIC_DOMAIN>/api/auth/github/callback
# (or SITE_URL/api/auth/github/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Connector grants (GitHub, Slack, ... tokens) are encrypted at rest.
# Single server: CONNECTOR_VAULT_PROVIDER=local with INTEGRATION_ENCRYPTION_KEY
# set to a Fernet key, which production requires; generate it with
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# and keep a copy in a password manager: backups hold the encrypted grants but
# never this key. With a cloud KMS instead, use aws-kms (or oci-kms on an Oracle
# VM, CONNECTOR_OCI_KMS_AUTH=instance-principal) and CONNECTOR_KMS_KEY_ID.
CONNECTOR_VAULT_PROVIDER=local
INTEGRATION_ENCRYPTION_KEY=
CONNECTOR_KMS_KEY_ID=
CONNECTOR_OCI_KMS_CRYPTO_ENDPOINT=
CONNECTOR_OCI_KMS_AUTH=instance-principal

AUTH_DEV_MODE=false
ORGMEMORY_DEMO_MODE=false
ALLOW_LOCAL_COMMAND_EXECUTION=false
ORG_MEMORY_EXECUTION_ALLOW_PUSH=false
ORGMEMORY_EMBEDDING_PROVIDER=fastembed
ORGMEMORY_RERANKER_PROVIDER=fastembed
CONNECTOR_CUSTOM_MCP_ALLOW_PRIVATE_NETWORKS=false
ORGMEMORY_API_URL=http://backend:8000
ORGMEMORY_API_KEY=
# MCP_PUBLIC_URL and MCP_OAUTH_ISSUER_URL are derived from PUBLIC_DOMAIN in
# compose.production.yml. Do not set ORGMEMORY_MCP_* here: those names take
# precedence and would override the derived values.
ORGMEMORY_ENABLE_LEGACY_TOOLS=false
ORGMEMORY_MCP_OAUTH_ENABLE_DCR=true
EMAIL_AUTH_ENABLED=false

# Add one or more model keys when you want generated answers. Connector sync,
# search, approvals, audit, and MCP discovery can run without these keys.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
GLM_MODEL=z-ai/glm-5.3-flash
GLM_BASE_URL=https://openrouter.ai/api/v1
ORG_MEMORY_DEFAULT_MODEL_PROVIDER=glm

# Nightly backups (deploy/server/backup.sh). Leave the bucket empty to keep
# backups on the server only. On an Oracle VM set OCI_CLI_AUTH=instance_principal;
# elsewhere the oci CLI uses ~/.oci/config.
OCI_BACKUP_BUCKET=
# OCI_CLI_AUTH=instance_principal
BACKUP_RETENTION_DAYS=14
