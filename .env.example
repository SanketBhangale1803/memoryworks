APP_NAME=MemoryWorks
ENVIRONMENT=development
LOG_LEVEL=INFO
API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
# Public site URL used for SEO/OG metadata in the Next.js layout.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# MCP server surface shown on the integrations screen. Empty falls back to
# ORGMEMORY_MCP_PUBLIC_URL + /mcp from the backend.
NEXT_PUBLIC_MCP_URL=
# Set true only for fully offline demo builds served from fixture data.
NEXT_PUBLIC_WEBMCP_OFFLINE=false
LOCAL_REPO_MOUNT=/workspace/local_repos

GRAPH_BACKEND=arcadedb
# Hostname of the graph database as seen from whoever is connecting.
# `localhost` is correct when you run the backend natively (the arcadedb
# container publishes 2480 on the host). docker-compose.yml overrides this
# with the `arcadedb` service name for the containerised backend, so this
# value only ever affects native runs.
ARCADEDB_HOST=localhost
ARCADEDB_PORT=2480
ARCADEDB_USER=root
# docker compose requires this variable (no default fallback). The dev value
# below is for local containers only; production must set a unique password.
ARCADEDB_PASSWORD=runbook_dev_password
ARCADEDB_DATABASE=runbook

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
OPENROUTER_API_KEY=
GLM_MODEL=z-ai/glm-5.3-flash
GLM_BASE_URL=https://openrouter.ai/api/v1
XAI_API_KEY=
GROK_MODEL=grok-4.5
KIMI_API_KEY=
KIMI_MODEL=kimi-k2.6
KIMI_BASE_URL=https://api.moonshot.ai/v1
ORG_MEMORY_DEFAULT_MODEL_PROVIDER=glm
# Each question is answered this many independent ways (max 5, 1 disables the
# pass) and a judge picks the answer that best fits what was actually asked.
ORG_MEMORY_ANSWER_CANDIDATES=5
ORG_MEMORY_ANSWER_JUDGE_ENABLED=true
# Answer basic non-company questions from the model's own knowledge instead of
# refusing. Company questions still refuse when memory holds nothing.
ORG_MEMORY_GENERAL_KNOWLEDGE_ENABLED=true
# Caps on model requests. Process-wide: in flight at once, started per minute,
# and the longest any single call may run.
LLM_MAX_CONCURRENT_REQUESTS=4
LLM_MAX_REQUESTS_PER_MINUTE=60
LLM_REQUEST_MAX_SECONDS=90
# Per answer: one budget shared by every model call it makes. When it runs out
# the answer falls back to what it already has instead of waiting.
ORG_MEMORY_ANSWER_LLM_BUDGET_SECONDS=75
ORG_MEMORY_ANSWER_MAX_LLM_CALLS=8
ORG_MEMORY_ANSWER_STREAM_TIMEOUT_SECONDS=150
# Per Agent-mode run.
ORG_AGENT_MAX_LLM_CALLS=12
ORG_AGENT_LLM_BUDGET_SECONDS=300
ORGMEMORY_EMBEDDING_PROVIDER=fastembed
ORGMEMORY_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
ORGMEMORY_RERANKER_PROVIDER=fastembed
ORGMEMORY_RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
ORGMEMORY_EMBEDDING_BATCH_SIZE=16
ORGMEMORY_MODEL_THREADS=2
ASSERTION_AUTO_VERIFY_ENABLED=true
ASSERTION_AUTO_VERIFY_DAYS=7

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_USE_PKCE=true
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/github/callback
GITHUB_WEBHOOK_SECRET=

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_REDIRECT_URI=http://localhost:8000/api/auth/slack/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
EMAIL_AUTH_ENABLED=true
EMAIL_CODE_TTL_MINUTES=10
EMAIL_CODE_RESEND_SECONDS=45
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
NEXTAUTH_SECRET=
JWT_SECRET=replace-with-a-long-random-secret
APP_BASE_URL=http://localhost:3000
AUTH_DEV_MODE=true
ORGMEMORY_SESSION_COOKIE_NAME=orgmemory_session
# Set to your parent domain in production, for example .orgmemory.example.com.
SESSION_COOKIE_DOMAIN=

# Workspace-scoped API key used by MCP clients such as Cursor. Create it in
# MemoryWorks's API Keys screen; keep the real value out of this file and source control.
ORGMEMORY_API_URL=http://localhost:8000
ORGMEMORY_API_KEY=
# Opt in only while migrating clients that still call runbook_* MCP tools.
ORGMEMORY_ENABLE_LEGACY_TOOLS=false

# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATION_ENCRYPTION_KEY=
# Local development uses the existing file-backed Fernet key. Production is
# fail-closed unless OAuth grants use AWS KMS or OCI Vault KMS with
# tenant/user/provider encryption context.
CONNECTOR_VAULT_PROVIDER=local
CONNECTOR_KMS_KEY_ID=
CONNECTOR_KMS_REGION=
# OCI Vault's per-vault crypto endpoint, for example
# https://<vault-id>-crypto.kms.us-chicago-1.oraclecloud.com
CONNECTOR_OCI_KMS_CRYPTO_ENDPOINT=
CONNECTOR_OCI_KMS_AUTH=instance-principal
CONNECTOR_OCI_CONFIG_PROFILE=DEFAULT
CONNECTOR_MANIFEST_PUBLIC_KEYS_JSON={}
CONNECTOR_SYNC_WORKER_ENABLED=true
# Run imports, syncs, webhooks, and watches in this process. Set false on the API
# and run `python -m app.worker` beside it (compose.production.yml does this).
BACKGROUND_WORK_ENABLED=true
CONNECTOR_SYNC_POLL_SECONDS=2
# Imports pause between files (up to this long) while someone is waiting on an answer.
CONNECTOR_SYNC_YIELD_TO_ANSWERS_SECONDS=60
CONNECTOR_CUSTOM_MCP_ENABLED=true
CONNECTOR_CUSTOM_MCP_ALLOW_PRIVATE_NETWORKS=false

ORGMEMORY_MCP_PUBLIC_URL=http://localhost:8001
ORGMEMORY_MCP_OAUTH_ISSUER_URL=http://localhost:8000
ORGMEMORY_MCP_OAUTH_ACCESS_TOKEN_MINUTES=60
ORGMEMORY_MCP_OAUTH_REFRESH_TOKEN_DAYS=30
ORGMEMORY_MCP_OAUTH_ENABLE_DCR=false
ORGMEMORY_DEMO_MODE=false
ALLOW_LOCAL_COMMAND_EXECUTION=false

# Incident-tool importers (migration layer). Leave empty to keep importers
# honestly reporting "not_connected".
PAGERDUTY_API_TOKEN=
ROOTLY_API_TOKEN=
INCIDENT_IO_API_TOKEN=
OPSGENIE_API_TOKEN=
STATUSPAGE_API_TOKEN=
JSM_API_TOKEN=
SERVICENOW_API_TOKEN=
ORG_MEMORY_ENABLE_ACTIONS=false
ORG_MEMORY_ENABLE_PROCEDURES=false
ORG_MEMORY_ENABLE_ADVANCED_RELIABILITY=false
