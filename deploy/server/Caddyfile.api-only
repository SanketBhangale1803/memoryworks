{
	email {$TLS_EMAIL}
}

# The web app stays on Vercel at SITE_URL and forwards /api/* and /.well-known/*
# here, so this VM serves only the API and the hosted MCP endpoint.

api.{$PUBLIC_DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 128MB
	}
	# Answers stream (/api/ask/stream, /api/org/ask/stream): hand every write to
	# the client as it happens instead of buffering it.
	reverse_proxy backend:8000 {
		flush_interval -1
	}
}

mcp.{$PUBLIC_DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 10MB
	}
	reverse_proxy mcp:8001
}
