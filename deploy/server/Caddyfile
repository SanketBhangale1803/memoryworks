{
	email {$TLS_EMAIL}
}

app.{$PUBLIC_DOMAIN} {
	encode zstd gzip
	reverse_proxy frontend:3000
}

api.{$PUBLIC_DOMAIN} {
	encode zstd gzip
	# Bound before buffering: proxy-level cap for JSON bodies and chunked
	# uploads, complementing the application guard.
	request_body {
		max_size 128MB
	}
	# Answers stream (/api/ask/stream, /api/org/ask/stream): hand every write to
	# the client as it happens instead of buffering it.
	reverse_proxy backend:8000 {
		flush_interval -1
	}
}

mcp.{$PUBLIC_DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 10MB
	}
	reverse_proxy mcp:8001
}
