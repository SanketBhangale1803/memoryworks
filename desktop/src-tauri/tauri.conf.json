{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MemoryWorks",
  "version": "0.1.0",
  "identifier": "ai.orgmemory.bridge",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": { "windows": [{ "title": "MemoryWorks Bridge", "width": 960, "height": 720, "minWidth": 680, "minHeight": 560 }], "security": { "csp": "default-src 'self'; connect-src 'self' http://localhost:8000 https://*; style-src 'self' 'unsafe-inline'" } },
  "bundle": { "active": true, "targets": "all", "createUpdaterArtifacts": true, "externalBin": ["binaries/orgmemory-mcp"] },
  "plugins": { "updater": { "pubkey": "REPLACE_WITH_RELEASE_PUBLIC_KEY", "endpoints": ["https://updates.orgmemory.ai/{{target}}/{{arch}}/{{current_version}}"] } }
}
