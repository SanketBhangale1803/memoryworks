FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    SQLITE_PATH=/tmp/orgmemory/runbook.db \
    GENERATED_RUNBOOKS_DIR=/tmp/orgmemory/generated_runbooks \
    REPO_CACHE_DIR=/tmp/orgmemory/repos \
    EXECUTION_DIR=/tmp/orgmemory/executions

RUN apt-get update \
    && apt-get install -y --no-install-recommends git curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace/orgmemory/backend
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .
RUN mkdir -p /tmp/orgmemory/generated_runbooks /tmp/orgmemory/repos /tmp/orgmemory/executions

# Vercel supplies PORT to container functions. The demo deliberately uses
# disposable SQLite state and the process-local graph; durable production is
# still the Compose/OCI deployment in deploy/server.
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-80}"]
